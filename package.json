{
  "name": "rtm-mcp",
  "version": "0.1.9",
  "description": "MCP server for the RTM (Requirements & Test Management) REST API v2 — exposes Requirements, Test Cases, Test Plans, Test Executions, Defects, Tree Structure and Automation as MCP tools.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "rtm-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RTM_LIVE=1 vitest run tests/integration",
    "lint": "echo 'lint not configured yet'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rtm",
    "requirements-test-management",
    "jira",
    "hexygen",
    "deviniti",
    "test-management",
    "qa"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngocdd/rtm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ngocdd/rtm-mcp/issues"
  },
  "homepage": "https://github.com/ngocdd/rtm-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
