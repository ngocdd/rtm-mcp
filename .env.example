# ============================================================
# RTM MCP Server — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
#
# How to generate the API token:
#   1. Open Jira
#   2. Go to Apps → Requirements and Test Management
#   3. Click the three-dot menu (...) → "Rest API authentication"
#   4. Click "Generate Token", select user, add a label
#   5. COPY THE TOKEN NOW — it cannot be retrieved later
# ============================================================

# Required. Bearer token for the RTM REST API.
RTM_API_TOKEN=

# Optional. Base URL for the RTM REST API.
#   - US/Global (default): https://rtm-us.deviniti.com/api
#   - EU:                   https://rtm-eu-api.hexygen.com/api
# You can confirm your URL from the "Rest API authentication" panel in Jira.
RTM_BASE_URL=https://rtm-us.deviniti.com/api

# Optional. One of: debug | info | warn | error. Default: info.
RTM_LOG_LEVEL=info

# Optional. Per-request HTTP timeout in milliseconds. Default: 30000.
RTM_TIMEOUT_MS=30000

# Optional. How many times to retry on 429/5xx/network errors. Default: 2.
RTM_MAX_RETRIES=2
